{
  "name": "@calibre/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Calibre API: markets, audits, guarded trades, settlement calibration, health",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --declaration false || tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@calibre/domain": "*",
    "@calibre/dreamdex-adapter": "*",
    "@calibre/validation": "*",
    "@somnia-chain/markets-sdk": "^0.29.0",
    "express": "^5.0.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
