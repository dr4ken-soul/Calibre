# Calibre environment template
# Copy to .env for local development. Never commit real keys.

# Web (Vite exposes only VITE_ prefixed keys to the browser)
VITE_APP_NAME=Calibre
VITE_CHAIN_ID=50312
VITE_RPC_URL=https://dream-rpc.somnia.network
VITE_API_URL=http://localhost:8787
# Live DreamDEX GraphQL indexer. Defaults to the Somnia testnet indexer.
# Set to "off" to force the clearly labeled deterministic fallback feed.
VITE_DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
VITE_DREAMDEX_API_URL=
VITE_DREAMDEX_MARKETS_ADDRESS=
VITE_DREAMDEX_EVENT_CONTRACT_ADDRESS=
VITE_WALLETCONNECT_PROJECT_ID=

# API
API_PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
DATABASE_URL=
# Server side DreamDEX integration. Defaults to the live GraphQL indexer.
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
DREAMDEX_API_URL=
STALE_AFTER_MS=90000
SETTLEMENT_POLL_MS=30000
AUDIT_RATE_LIMIT_PER_MINUTE=30

# AI (optional). Empty keeps the fully deterministic audit path.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Audit thresholds
AUDIT_MIN_EDGE=0.05
AUDIT_MIN_CONFIDENCE=0.65
AUDIT_MAX_SLIPPAGE=0.02
AUDIT_MIN_SECONDS_TO_EXPIRY=120
